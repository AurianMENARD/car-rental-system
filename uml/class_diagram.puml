@startuml
skinparam classAttributeIconSize 0
hide circle
hide empty members

' =========================
' Enums
' =========================
enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RentalStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

' =========================
' Domain: Vehicles
' =========================
abstract class Vehicle {
  - id: str
  - brand: str
  - model: str
  - category: str
  - daily_rate: float
  - status: VehicleStatus
  + get_type(): str
  + is_rentable(): bool
}

class Car {
  - seats: int
  + get_type(): str
}

class Truck {
  - payload_kg: int
  + get_type(): str
}

class Motorcycle {
  - engine_cc: int
  + get_type(): str
}

Vehicle <|-- Car
Vehicle <|-- Truck
Vehicle <|-- Motorcycle

' =========================
' Domain: Customer
' =========================
class Customer {
  - id: str
  - first_name: str
  - last_name: str
  - age: int
  - license_number: str
  - rental_history: List<Rental>
  + full_name(): str
  + add_to_history(rental: Rental): void
}

' =========================
' Domain: Rental
' =========================
class Rental {
  - id: str
  - customer: Customer
  - vehicle: Vehicle
  - start_date: date
  - end_date: date
  - status: RentalStatus
  - total_cost: float
  - returned_at: date?
  + duration_days(): int
  + overlaps(start: date, end: date): bool
  + is_active_on(day: date): bool
}

Customer "1" o-- "0..*" Rental : history
Vehicle  "1" o-- "0..*" Rental : rentals
Rental --> Customer
Rental --> Vehicle

' =========================
' Advanced option: Maintenance
' =========================
class MaintenanceRecord {
  - id: str
  - vehicle_id: str
  - start_date: date
  - end_date: date?
  - description: str
  + is_active_on(day: date): bool
}

Vehicle "1" o-- "0..*" MaintenanceRecord : maintenance

' =========================
' Services / Rules
' =========================
class AgePolicy {
  + min_age_for(vehicle: Vehicle): int
  + is_eligible(customer: Customer, vehicle: Vehicle): bool
}

class AvailabilityPolicy {
  + is_available(vehicle: Vehicle, start: date, end: date, rentals: List<Rental>, maint: List<MaintenanceRecord>): bool
}

class PricingPolicy {
  - late_fee_per_day: float
  + calculate_base_cost(vehicle: Vehicle, start: date, end: date): float
  + calculate_late_fee(planned_end: date, returned_at: date, late_fee_per_day: float): float
  + calculate_total(vehicle: Vehicle, start: date, end: date, returned_at: date?): float
}

' =========================
' Reports
' =========================
class ReportsService {
  + available_vehicles(vehicles: List<Vehicle>, rentals: List<Rental>, start: date, end: date): List<Vehicle>
  + ongoing_rentals(rentals: List<Rental>, on_date: date): List<Rental>
  + revenue(rentals: List<Rental>, start: date, end: date): float
  + stats_by_vehicle_type(rentals: List<Rental>): Map<str,int>
}

' =========================
' Central System
' =========================
class CarRentalSystem {
  - vehicles: Dict<str, Vehicle>
  - customers: Dict<str, Customer>
  - rentals: Dict<str, Rental>
  - maintenance: Dict<str, List<MaintenanceRecord>>
  - age_policy: AgePolicy
  - availability_policy: AvailabilityPolicy
  - pricing_policy: PricingPolicy
  - reports: ReportsService

  + add_vehicle(vehicle: Vehicle): void
  + remove_vehicle(vehicle_id: str): void
  + update_vehicle_status(vehicle_id: str, status: VehicleStatus): void
  + list_vehicles(): List<Vehicle>
  + find_vehicle(vehicle_id: str): Vehicle?

  + add_customer(customer: Customer): void
  + find_customer(customer_id: str): Customer?
  + list_customers(): List<Customer>

  + create_rental(customer_id: str, vehicle_id: str, start: date, end: date): Rental
  + start_rental(rental_id: str, on_date: date): void
  + return_vehicle(rental_id: str, returned_at: date): float
  + cancel_rental(rental_id: str): void

  + available_vehicles(start: date, end: date): List<Vehicle>
  + ongoing_rentals(on_date: date): List<Rental>
  + revenue(start: date, end: date): float
  + statistics(): Map<str, any>

  + schedule_maintenance(vehicle_id: str, start: date, end: date, description: str): MaintenanceRecord
}

CarRentalSystem *-- Vehicle
CarRentalSystem *-- Customer
CarRentalSystem *-- Rental
CarRentalSystem *-- MaintenanceRecord
CarRentalSystem *-- AgePolicy
CarRentalSystem *-- AvailabilityPolicy
CarRentalSystem *-- PricingPolicy
CarRentalSystem *-- ReportsService

' =========================
' Notes: Key rules (optional)
' =========================
note right of Rental
overlaps(A,B) if:
A.start < B.end AND B.start < A.end
end_date is exclusive OR inclusive (choose one)
end note

note right of AvailabilityPolicy
Available if:
- vehicle.status == AVAILABLE
- no active rental overlaps
- no maintenance overlaps
end note

@enduml
